{"name":"31DEcember2025","settings":"{\"settings\":\"{\\n    // === 01. File & Folder Management ===\\n    \\\"files.exclude\\\": {\\n        // Excludes these directories/files from the Explorer panel\\n        \\\"**/.kiro\\\": true,\\n        \\\"**/*.js\\\": {\\n            // Hides .js files when a corresponding .ts file exists (common for TypeScript projects)\\n            \\\"when\\\": \\\"$(basename).ts\\\"\\n        },\\n        \\\"**/vendor\\\": true\\n    },\\n    \\\"search.exclude\\\": {\\n        \\\"**/node_modules\\\": true,\\n        \\\"**/build\\\": true,\\n        \\\"**/dist\\\": true,\\n        \\\"**/coverage\\\": true\\n    },\\n    \\\"explorer.compactFolders\\\": false, // Shows folders in a non-compact, hierarchical view\\n    \\\"files.autoSave\\\": \\\"off\\\",          // Disables auto-saving files\\n    \\\"explorer.confirmDelete\\\": false,  // Disables the confirmation prompt when deleting files\\n    \\\"extensions.ignoreRecommendations\\\": true, // Hides extension recommendations\\n\\n    // === 02. Editor Appearance & Behavior ===\\n    \\\"editor.fontFamily\\\": \\\"JetBrains Mono\\\", // Primary font set for the editor\\n    \\\"editor.lineHeight\\\": 24,               // Custom line height (in pixels) for better readability\\n    \\\"editor.fontWeight\\\": \\\"normal\\\",         // Sets the default font weight\\n    \\\"editor.tabSize\\\": 10,                   // Sets indentation size to 3 spaces\\n    \\\"editor.wordWrap\\\": \\\"off\\\",               // Enables word wrapping\\n    \\\"editor.lineNumbers\\\": \\\"on\\\",            // Shows line numbers in the gutter\\n    \\\"editor.folding\\\": true,                // Enables code folding regions\\n    \\\"editor.codeLens\\\": true,               // Enables CodeLens links (e.g., references, implementions)\\n    \\\"editor.hover.enabled\\\": \\\"on\\\",          // Enables hover pop-ups\\n    \\\"editor.colorDecorators\\\": false,       // Disables color previews next to color codes\\n    \\\"editor.bracketPairColorization.enabled\\\": false, // Disables coloring matching bracket pairs\\n    \\\"editor.fontLigatures\\\": true,          // Enables font ligatures (e.g., '=>' becomes a single character)\\n    \\\"editor.cursorSmoothCaretAnimation\\\": \\\"on\\\", // Smooth animation for cursor movement\\n    \\\"editor.renderControlCharacters\\\": false, // Hides visual representation of control characters\\n    \\\"editor.stickyScroll.enabled\\\": false,  // Disables the sticky scroll feature at the top of the editor\\n    \\\"editor.largeFileOptimizations\\\": false, // Disables optimizations for large files\\n\\n    // === 03. Editor Cursor & Suggestion Settings ===\\n    \\\"editor.cursorBlinking\\\": \\\"blink\\\",\\n    \\\"editor.cursorStyle\\\": \\\"line\\\",\\n    \\\"editor.suggestSelection\\\": \\\"first\\\",\\n    \\\"editor.acceptSuggestionOnCommitCharacter\\\": false, // Prevents auto-accepting suggestions upon typing certain characters\\n    \\\"editor.suggest.showWords\\\": true, // Shows suggestions from words in the document\\n    \\\"editor.quickSuggestions\\\": {\\n        \\\"other\\\": true,\\n        \\\"comments\\\": true,\\n        \\\"strings\\\": true\\n    },\\n    \\\"editor.inlineSuggest.enabled\\\": true, // Enables inline ghost text suggestions\\n\\n    // === 04. Editor Formatting & Minimap ===\\n    \\\"editor.formatOnPaste\\\": false, // Disables automatic formatting when pasting\\n    \\\"editor.formatOnType\\\": false,  // Disables automatic formatting while typing\\n    \\\"editor.glyphMargin\\\": false,   // Hides the gutter area for Git/debugging glyphs\\n    \\\"editor.minimap.enabled\\\": false,     // Disables the code minimap overview on the side\\n    \\\"editor.minimap.showSlider\\\": \\\"always\\\", // (Setting is ignored since minimap is disabled)\\n    \\\"editor.minimap.sectionHeaderFontSize\\\": 12, // (Setting is ignored since minimap is disabled)\\n    \\\"editor.find.findOnType\\\": false, // Disables finding as you type in the editor\\n\\n    // === 05. Color Theme & Customizations ===\\n    \\\"workbench.colorTheme\\\": \\\"βui - Material Darker\\\",\\n    \\\"workbench.iconTheme\\\": \\\"kardia-file-icon\\\",\\n    \\\"workbench.activityBar.location\\\": \\\"top\\\", // Moves the activity bar to the top\\n    \\\"workbench.startupEditor\\\": \\\"none\\\",      // Opens an empty editor on startup\\n    \\\"workbench.secondarySideBar.defaultVisibility\\\": \\\"hidden\\\", // Hides the secondary sidebar by default\\n    \\\"workbench.colorCustomizations\\\": {\\n        \\\"editor.background\\\": \\\"#0d1016\\\",\\n        \\\"editor.\\\": \\\"#0d1016\\\",\\n        \\\"titleBar.activeBackground\\\": \\\"#0d1016\\\",\\n        \\\"editorPane.background\\\": \\\"#0d1016\\\",\\n        \\\"editorGroupHeader.tabsBackground\\\": \\\"#0d1016\\\",\\n        \\\"tab.inactiveBackground\\\": \\\"#0d1016\\\",\\n        \\\"tab.inactiveForeground\\\": \\\"#ffffff\\\",\\n        \\\"tab.activeBackground\\\": \\\"#1e242d\\\",\\n        \\\"tab.activeForeground\\\": \\\"#ffffff\\\",\\n        \\\"sideBar.background\\\": \\\"#1f2127\\\",\\n        \\\"sideBar.foreground\\\": \\\"#fff\\\",\\n        \\\"sideBarTitle.background\\\": \\\"#0d1016\\\",\\n        \\\"sideBarTitle.foreground\\\": \\\"#fff\\\",\\n        \\\"activityBar.background\\\": \\\"#0d1016\\\",\\n        \\\"activityBar.foreground\\\": \\\"#fff\\\",\\n        \\\"statusBar.background\\\": \\\"#0d1016\\\",\\n        \\\"statusBar.foreground\\\": \\\"#fff\\\",\\n        \\\"terminal.background\\\": \\\"#0d1016\\\",\\n        \\\"terminal.foreground\\\": \\\"#fff\\\",\\n        \\\"editor.lineHighlightBackground\\\": \\\"#1073cf2d\\\",\\n        \\\"editor.lineHighlightBorder\\\": \\\"#9fced11f\\\"\\n    },\\n\\n    // Indent Rainbow Extension Settings (New Section) ===\\n    \\\"editor.guides.indentation\\\": false,\\n    \\\"indent-rainbow.indicatorStyle\\\": \\\"light\\\",\\n    \\\"indent-rainbow.lightIndicatorStyleLineWidth\\\": 2,\\n    // \\\"workbench.editor.showTabs\\\": \\\"single\\\", // (Commented out)\\n\\n    // === 06. Syntax Highlighting Customizations (TextMate Rules) ===\\n    \\\"editor.tokenColorCustomizations\\\": {\\n        \\\"textMateRules\\\": [\\n            // Sets comments, storage types, support types/classes, and parameters to italic\\n            {\\\"scope\\\": \\\"comment\\\", \\\"settings\\\": {\\\"fontStyle\\\": \\\"italic\\\"}},\\n            {\\\"scope\\\": \\\"storage.type\\\", \\\"settings\\\": {\\\"fontStyle\\\": \\\"italic\\\"}},\\n            {\\\"scope\\\": \\\"support.type, support.class\\\", \\\"settings\\\": {\\\"fontStyle\\\": \\\"italic\\\"}},\\n            {\\\"scope\\\": \\\"variable.parameter\\\", \\\"settings\\\": {\\\"foreground\\\": \\\"#FD971F\\\", \\\"fontStyle\\\": \\\"italic\\\"}},\\n            // Underlines class/type names\\n            {\\\"scope\\\": \\\"entity.name.type, entity.name.class, entity.name.namespace, entity.name.scope-resolution\\\", \\\"settings\\\": {\\\"fontStyle\\\": \\\"underline\\\"}},\\n            // Styles inherited classes\\n            {\\\"scope\\\": \\\"entity.other.inherited-class\\\", \\\"settings\\\": {\\\"foreground\\\": \\\"#A6E22E\\\", \\\"fontStyle\\\": \\\"italic underline\\\"}},\\n            // Markdown styling rules (bold headings, italic quotes/emphasis, strikethrough)\\n            {\\\"scope\\\": \\\"markup.heading.setext\\\", \\\"settings\\\": {\\\"fontStyle\\\": \\\"bold\\\"}},\\n            {\\\"scope\\\": \\\"markup.heading.markdown\\\", \\\"settings\\\": {\\\"fontStyle\\\": \\\"bold\\\"}},\\n            {\\\"scope\\\": \\\"markup.quote.markdown\\\", \\\"settings\\\": {\\\"fontStyle\\\": \\\"italic\\\"}},\\n            {\\\"scope\\\": \\\"markup.bold.markdown\\\", \\\"settings\\\": {\\\"fontStyle\\\": \\\"bold\\\"}},\\n            {\\\"scope\\\": \\\"markup.italic.markdown\\\", \\\"settings\\\": {\\\"fontStyle\\\": \\\"italic\\\"}},\\n            {\\\"scope\\\": \\\"markup.strikethrough\\\", \\\"settings\\\": {\\\"fontStyle\\\": \\\"strikethrough\\\"}}\\n        ]\\n    },\\n\\n    // === 07. Terminal Settings ===\\n    \\\"terminal.integrated.fontFamily\\\": \\\"Iosevka Custom\\\", // Font set for the integrated terminal\\n    \\\"terminal.integrated.copyOnSelection\\\": true,      // Copies selected text automatically\\n    \\\"terminal.integrated.cursorBlinking\\\": true,\\n    \\\"terminal.integrated.enableMultiLinePasteWarning\\\": \\\"auto\\\",\\n    \\\"terminal.integrated.env.windows\\\": {},\\n    \\\"terminal.integrated.stickyScroll.enabled\\\": false, // Disables sticky scroll in the terminal\\n\\n    // === 08. Git & Diff Editor Settings ===\\n    \\\"git.enableSmartCommit\\\": true,      // Enables staging all changes when committing with no staged changes\\n    \\\"git.confirmSync\\\": false,           // Disables confirmation before syncing Git changes\\n    \\\"git.openRepositoryInParentFolders\\\": \\\"always\\\",\\n    \\\"git.autofetch\\\": false,              // Automatically fetches from remotes\\n    \\\"git.ignoreRebaseWarning\\\": true,    // Hides the warning when a rebase is initiated\\n    \\\"diffEditor.renderSideBySide\\\": true,      // Renders the diff editor in the inline view\\n    \\\"diffEditor.ignoreTrimWhitespace\\\": false,  // Considers trailing whitespace changes as significant\\n    \\\"diffEditor.maxComputationTime\\\": 0,        // Removes the time limit for diff computation\\n    \\\"diffEditor.hideUnchangedRegions.enabled\\\": true, // Hides unchanged code sections in diff view\\n    \\\"diffEditor.codeLens\\\": true,               // Enables CodeLens in the diff editor\\n    \\\"gitlens.views.stashes.files.layout\\\": \\\"tree\\\", // Sets GitLens stash file view to tree layout\\n\\n    // === 09. TypeScript/Language Settings ===\\n    \\\"typescript.updateImportsOnFileMove.enabled\\\": \\\"always\\\", // Automatically updates import paths when files are moved\\n\\n    // === 10. AI/Code Assistance (Copilot/Gemini) Settings ===\\n    \\\"github.copilot.nextEditSuggestions.enabled\\\": false, // Disables Copilot's multi-step edit suggestions\\n    \\\"github.copilot.enable\\\": { // Disables Copilot for all file types\\n        \\\"plaintext\\\": false,\\n        \\\"markdown\\\": false,\\n        \\\"scminput\\\": false,\\n        \\\"*\\\": false\\n    }, // Enables AI-related statistics\\n\\n    // === 11. Chat & Markdown Settings ===\\n    \\\"chat.instructionsFilesLocations\\\": {\\n        // Paths for custom instruction files used by chat features\\n        \\\".github/instructions\\\": true,\\n        \\\"C:\\\\\\\\Users\\\\\\\\dhull\\\\\\\\AppData\\\\\\\\Local\\\\\\\\Temp\\\\\\\\postman-http-request-post-response.instructions.md\\\": true,\\n        \\\"C:\\\\\\\\Users\\\\\\\\dhull\\\\\\\\AppData\\\\\\\\Local\\\\\\\\Temp\\\\\\\\postman-http-request-pre-request.instructions.md\\\": true,\\n        \\\"C:\\\\\\\\Users\\\\\\\\dhull\\\\\\\\AppData\\\\\\\\Local\\\\\\\\Temp\\\\\\\\postman-collections-post-response.instructions.md\\\": true,\\n        \\\"C:\\\\\\\\Users\\\\\\\\dhull\\\\\\\\AppData\\\\\\\\Local\\\\\\\\Temp\\\\\\\\postman-collections-pre-request.instructions.md\\\": true,\\n        \\\"C:\\\\\\\\Users\\\\\\\\dhull\\\\\\\\AppData\\\\\\\\Local\\\\\\\\Temp\\\\\\\\postman-folder-post-response.instructions.md\\\": true,\\n        \\\"C:\\\\\\\\Users\\\\\\\\dhull\\\\\\\\AppData\\\\\\\\Local\\\\\\\\Temp\\\\\\\\postman-folder-pre-request.instructions.md\\\": true\\n    },\\n    \\\"chat.commandCenter.enabled\\\": false, // Disables some AI features in chat\\n    \\\"chat.editor.fontSize\\\": 15,          // Font size for chat in the editor area\\n    \\\"chat.fontSize\\\": 15,                 // Font size for the main chat panel\\n    \\\"markdown.preview.fontSize\\\": 15,     // Font size for the Markdown preview\\n\\n    // === 12. Other Tool/Extension Settings ===\\n    \\\"liveServer.settings.donotShowInfoMsg\\\